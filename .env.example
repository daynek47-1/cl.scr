# Database
DATABASE_URL=sqlite:///./casino_intelligence.db

# Casino Credentials (Single set for all sites)
CASINO_USERNAME=your_username
CASINO_PASSWORD=your_password

# Session Management
SESSION_CACHE_HOURS=6
SESSION_RETRY_MAX=3

# Worker Configuration
WORKER_COUNT=5
WORKER_DELAY_MIN=2
WORKER_DELAY_MAX=5
WORKER_TIMEOUT=30

# Display Mode
QUIET_MODE=true  # Only show 2-line console output (recommended for clean display)

# Proxy Configuration (Optional)
USE_PROXIES=false
PROXY_LIST=http://proxy1:port,http://proxy2:port,http://proxy3:port

# Site Health Management
PURGATORY_FAIL_THRESHOLD=5
PURGATORY_CHECK_INTERVAL=5
RESURRECTION_CHECK_INTERVAL=125

# API Configuration
API_HOST=0.0.0.0
API_PORT=8000

# PV (Perceived Value) Algorithm
USE_V14_FORMULA=true  # Use sophisticated V14 algorithm (recommended)

# PV Weights (only used if USE_V14_FORMULA=false - for testing/legacy)
PV_BONUS_WEIGHT=1.0
PV_ROLLOVER_WEIGHT=0.5
PV_MAX_WITHDRAWAL_WEIGHT=0.3

# V14 Algorithm Details:
# Formula: (10 * log2(mw + 1) * sqrt(ba)) / (pow(ro, 1.25) * log10(ba + 10))
# - Non-linear with logarithmic scaling
# - Diminishing returns on high max withdrawals
# - Exponential penalties on high rollovers
# - More realistic than simple linear calculation
